# Python
__pycache__/
*.pyc

# runtime data (default AGENT_CLI_LOGS lives outside the repo, but ignore it
# defensively in case someone points it at a repo-local path)
agent-cli-logs/
projects.json

# OS cruft
.DS_Store
Thumbs.db

# editor/local overrides
.vscode/
.idea/
*.local.json

# per-task agent checkpoints: written by every `agent.sh run` into the working
# directory, useful while a task is live and worthless in history. They leaked
# into a commit once via `git add -A`; this is the guard against a repeat.
PROGRESS.*.md
